# The settings of the panel.
#
# This file is read by `docker compose`. The local development (`pnpm dev`)
# does not read it - it runs with the built in defaults. The variables of the
# server itself are described in apps/api/README.md.
#
# Copy the file and fill in the two secrets:
#
#   cp .env.example .env
#   sed -i "s|^PANEL_PASSWORD=.*|PANEL_PASSWORD=tvoje-heslo|" .env
#   sed -i "s|^PANEL_SECRET=.*|PANEL_SECRET=$(openssl rand -hex 32)|" .env

# The password of the gate - one password for the whole panel.
# Without it the built in password "muni2026" is used and the server says so.
PANEL_PASSWORD=change-me

# The key the sessions are signed with. Without it a random key is made when
# the server starts, so every restart ends all the sessions.
# Generate one with: openssl rand -hex 32
PANEL_SECRET=change-me

# The addresses the web panel is served from (comma separated).
# Without it the API answers every address.
WEB_ORIGIN=http://localhost:8080

# How many proxies are in front of the API ("loopback" is the default).
TRUST_PROXY=1

# The port the web panel is published on.
WEB_PORT=8080

# How many minutes are between two backups (60 = every hour).
BACKUP_MINUTES=60

# How many backups are kept (48 = two days of hourly backups).
BACKUP_KEEP=24
